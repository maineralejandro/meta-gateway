# === WHATSAPP SANDBOX (META) ===
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME

# === LLM (NVIDIA NIM) ===
LLM_PROVIDER=nvidia
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
LLM_API_KEY=nvapi-REPLACE_ME
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# === DATABASE ===
DB_DIR=/tmp/hermes
DB_NAME=whatsapp_conversations.db

# === META API ===
META_API_URL=https://graph.facebook.com/v25.0

# === API SERVER ===
API_HOST=0.0.0.0
API_PORT=8080

# === DASHBOARD AUTH ===
DASHBOARD_TOKEN=REPLACE_ME

# === CORS ===
# Comma-separated origins. Use * for dev, specific domain for prod.
CORS_ORIGINS=*
