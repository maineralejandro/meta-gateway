# === WHATSAPP SANDBOX (META) ===
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME

# === LLM (NVIDIA NIM) ===
LLM_PROVIDER=nvidia
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
LLM_API_KEY=nvapi-REPLACE_ME
E2E_LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# === DATABASE (PostgreSQL via Supabase) ===
# Docker Compose: postgresql://postgres:postgres@supabase_db_app:5432/postgres
# Supabase CLI local: postgresql://postgres:postgres@localhost:54322/postgres
# Supabase Cloud: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# === META API ===
META_API_URL=https://graph.facebook.com/v25.0

# === API SERVER ===
API_HOST=0.0.0.0
API_PORT=8080

# === DASHBOARD AUTH ===
DASHBOARD_TOKEN=REPLACE_ME

# === CORS ===
CORS_ORIGINS=*

# === TOOL CALLING ===
TOOL_MAX_ITERATIONS=5
TOOL_EXECUTION_TTL=300
